{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private versioned backup storage only. Review costs, retention, KMS requirements and access policy before deploying. Does not deploy the application.",
  "Resources": {
    "WorkflowBackups": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": { "Status": "Enabled" },
        "BucketEncryption": { "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }] },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true, "BlockPublicPolicy": true,
          "IgnorePublicAcls": true, "RestrictPublicBuckets": true
        },
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] }
      }
    },
    "RequireTransportEncryption": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "WorkflowBackups" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Sid": "DenyInsecureTransport", "Effect": "Deny", "Principal": "*", "Action": "s3:*",
            "Resource": [
              { "Fn::GetAtt": ["WorkflowBackups", "Arn"] },
              { "Fn::Join": ["", [{ "Fn::GetAtt": ["WorkflowBackups", "Arn"] }, "/*"]] }
            ],
            "Condition": { "Bool": { "aws:SecureTransport": "false" } }
          }]
        }
      }
    }
  }
}
